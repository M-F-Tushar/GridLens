
GRIDLENS_APP_NAME=GridLens
GRIDLENS_ENV=development
GRIDLENS_MAX_HORIZON_HOURS=168

# LLM Provider options: "local" (default, offline), "openrouter", "groq"
GRIDLENS_LLM_PROVIDER=local

# OpenRouter configuration (free models available)
OPENROUTER_API_KEY=
GRIDLENS_OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/chat/completions

# Groq configuration (generous free tier)
GROQ_API_KEY=
GRIDLENS_GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1/chat/completions

GRIDLENS_REQUEST_TIMEOUT_SECONDS=10.0
GRIDLENS_MAX_RETRIES=3
GRIDLENS_CORS_ORIGINS=http://localhost:7860,http://127.0.0.1:7860